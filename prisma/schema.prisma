generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id             Int     @id @default(autoincrement())
  mark           String  @unique
  markAutotechId Int     @unique
  active         Boolean @default(true)
  image          String?
  models         Model[]
}

model Model {
  id              Int            @id @default(autoincrement())
  model           String
  modelAutotechId Int
  range           String
  active          Boolean        @default(true)
  image           String?
  brandId         Int
  brand           Brand          @relation(fields: [brandId], references: [id])
  modifications   Modification[]

  @@unique([brandId, modelAutotechId])
}

model Modification {
  id                     Int                  @id @default(autoincrement())
  modificationAutotechId Int
  typeName               String?
  typeRange              String?
  kw                     String?
  hp                     String?
  ccmTech                Int?
  capacity               Decimal?
  cylinders              Int?
  valve                  Int?
  tonnage                Int?
  active                 Boolean              @default(true)
  image                  String?
  fuelId                 Int
  engineTypeId           Int
  fuelPreparationId      Int
  bodyTypeId             Int
  driveTypeId            Int
  modelId                Int
  bodyType               BodyType             @relation(fields: [bodyTypeId], references: [id])
  driveType              DriveType            @relation(fields: [driveTypeId], references: [id])
  engineType             EngineType           @relation(fields: [engineTypeId], references: [id])
  fuel                   Fuel                 @relation(fields: [fuelId], references: [id])
  fuelPreparation        FuelPreparation      @relation(fields: [fuelPreparationId], references: [id])
  model                  Model                @relation(fields: [modelId], references: [id])
  engines                ModificationEngine[]
  catalogs               CatalogCar[]

  @@unique([modelId, modificationAutotechId])
  @@index([modelId])
  @@index([modelId, fuelId, engineTypeId])
  @@index([modelId, bodyTypeId, driveTypeId])
}

model Engine {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  modifications ModificationEngine[]
}

model ModificationEngine {
  id             Int          @id @default(autoincrement())
  modificationId Int
  engineId       Int
  engine         Engine       @relation(fields: [engineId], references: [id])
  modification   Modification @relation(fields: [modificationId], references: [id])

  @@unique([modificationId, engineId])
  @@index([engineId, modificationId])
}

model Fuel {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model EngineType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model FuelPreparation {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model BodyType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model DriveType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model CatalogCar {
  id             Int      @id @default(autoincrement())
  groupId        Int
  groupCode      String
  subGroupCode   String
  count          Int
  typeAutotechId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modificationId Int
  modification   Modification @relation(fields: [modificationId], references: [id])

  @@unique([modificationId, groupCode, subGroupCode])
  @@index([modificationId])
}
