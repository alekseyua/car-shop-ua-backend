generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id             Int     @id @default(autoincrement())
  mark           String  @unique
  markAutotechId Int     @unique
  active         Boolean @default(true)
  image          String?
  models         Model[]
}

model Model {
  id              Int            @id @default(autoincrement())
  model           String
  modelAutotechId Int
  range           String
  active          Boolean        @default(true)
  image           String?
  brandId         Int
  brand           Brand          @relation(fields: [brandId], references: [id])
  modifications   Modification[]

  @@unique([brandId, modelAutotechId])
}

model Modification {
  id                     Int                  @id @default(autoincrement())
  modificationAutotechId Int
  typeName               String?
  typeRange              String?
  kw                     String?
  hp                     String?
  ccmTech                Int?
  capacity               Decimal?
  cylinders              Int?
  valve                  Int?
  tonnage                Int?
  active                 Boolean              @default(true)
  image                  String?
  fuelId                 Int
  engineTypeId           Int
  fuelPreparationId      Int
  bodyTypeId             Int
  driveTypeId            Int
  modelId                Int
  bodyType               BodyType             @relation(fields: [bodyTypeId], references: [id])
  driveType              DriveType            @relation(fields: [driveTypeId], references: [id])
  engineType             EngineType           @relation(fields: [engineTypeId], references: [id])
  fuel                   Fuel                 @relation(fields: [fuelId], references: [id])
  fuelPreparation        FuelPreparation      @relation(fields: [fuelPreparationId], references: [id])
  model                  Model                @relation(fields: [modelId], references: [id])
  engines                ModificationEngine[]
  catalogs               CatalogCar[]

  @@unique([modelId, modificationAutotechId])
  @@index([modelId])
  @@index([modelId, fuelId, engineTypeId])
  @@index([modelId, bodyTypeId, driveTypeId])
}

model Engine {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  modifications ModificationEngine[]
}

model ModificationEngine {
  id             Int          @id @default(autoincrement())
  modificationId Int
  engineId       Int
  engine         Engine       @relation(fields: [engineId], references: [id])
  modification   Modification @relation(fields: [modificationId], references: [id])

  @@unique([modificationId, engineId])
  @@index([engineId, modificationId])
}

model Fuel {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model EngineType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model FuelPreparation {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model BodyType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model DriveType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  modifications Modification[]
}

model CatalogCar {
  id             Int      @id @default(autoincrement())
  groupId        Int
  groupCode      String
  subGroupCode   String
  count          Int
  typeAutotechId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modificationId Int
  modification   Modification @relation(fields: [modificationId], references: [id])

  @@index([modificationId])
}

model ListOEMByItem {
  id Int @id @default(autoincrement())
  brand String
  code String
  comId Int
  itemNo String
  search String

  @@index([itemNo])
  @@index([code])
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id Int @id @default(autoincrement())
  lastName String
  firstName String?
  birthDate DateTime?
  nickname String @unique

  email String @unique
  emailVerified Boolean @default(false)
  lastLoginAt DateTime?
  emailVerificationTokenHash String?

  passwordHash String
  resetPasswordTokenHash String?
  resetPasswordExp DateTime?

  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatarUrl String?
  phone String? @unique

  role Role @default(USER)

  cart Cart?
  addresses Address[]
  favorites Favorite[]
  orders    Order[]
  reviews   Review[]
  history   History[]
}

model Address {
  id         Int    @id @default(autoincrement())

  country    String
  city       String
  street     String
  house      String
  apartment  String?

  postalCode String?

  isDefault  Boolean @default(false)

  userId     Int
  user       User @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        Int @id @default(autoincrement())

  userId    Int
  user      User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  productId String

  @@unique([userId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         Int @id @default(autoincrement())

  totalPrice Decimal @db.Decimal(10, 2)

  status     OrderStatus @default(PENDING)

  userId     Int
  user       User @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order Order @relation(fields: [orderId], references: [id])

  productId String

  title String

  quantity Int

  price Decimal @db.Decimal(10,2)

  imageUrl String?
}

model Review {
  id        Int @id @default(autoincrement())

  rating    Int?
  comment   String?
  productId String?

  userId    Int
  user      User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum HistoryAction {
  LOGIN
  LOGOUT
  ADD_TO_CART
  REMOVE_FROM_CART
  CREATE_ORDER
  CANCEL_ORDER
}

model History {
  id        Int @id @default(autoincrement())

  action    HistoryAction
  metadata  Json?

  userId    Int
  user      User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Cart {
  id Int @id @default(autoincrement())

  userId Int @unique
  user User @relation(fields: [userId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId Int
  cart Cart @relation(fields: [cartId], references: [id])

  productId String

  title String

  quantity Int @default(1)

  price Decimal @db.Decimal(10,2)

  imageUrl String?

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

